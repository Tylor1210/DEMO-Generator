{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "../pipeline/**/*.ts", "../workspace/stages/**/scripts/*.ts"],
  "exclude": ["../pipeline/write-schema.ts", "../pipeline/lib/html-node.ts"]
}
