# Copy to .env (CLI) or .dev.vars (wrangler). Never commit the real file.
ANTHROPIC_API_KEY=
# anthropic (local and Worker) | workers-ai (Worker only, Phase 3)
MODEL_PROVIDER=anthropic
MODEL_STRONG=claude-opus-5-5
MODEL_CHEAP=claude-haiku-5-5
# effort for agent stages: low | medium | high
MODEL_EFFORT=medium
DAILY_SPEND_CAP_USD=5
REVIEW_MODE=auto
# How many days a published demo page stays live (not related to API keys)
DEMO_TTL_DAYS=30
PUBLIC_HOST=tycodes.app
